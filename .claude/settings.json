{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git switch *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(agent-review.py*)",
      "Bash(autopilot-poll.py*)",
      "Bash(autopilot-state.py*)",
      "Bash(autopilot-task.py*)",
      "Bash(autopilot-restart.sh*)",
      "Bash(check-project.py*)",
      "Bash(.claude/skills/pipeline/bin/check-project.py*)",
      "Bash(cleanup-tree.py*)",
      "Bash(default-branch.py*)",
      "Bash(gate *)",
      "Bash(issue-pr.py*)",
      "Bash(issue-text.py*)",
      "Bash(leave-branch.py*)",
      "Bash(merge-default-branch.py*)",
      "Bash(open-review-threads.py*)",
      "Bash(pipeline-metrics.py*)",
      "Bash(post-plan.py*)",
      "Bash(cat > .pipeline/*)",
      "Bash(release-changed.sh*)",
      "Bash(.claude/skills/pipeline/host/update-pipeline.sh*)",
      "Bash(.claude/skills/pipeline/host/use-release.sh*)",
      "Bash(telegram-send.py*)",
      "Bash(watch-ci.py*)",
      "mcp__plugin_telegram_telegram",
      "Read(~/.claude/channels/telegram/access.json)",
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff *)",
      "Bash(claude plugin validate*)",
      "Bash(bin/check-project.py*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :**)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(gh repo delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh label delete*)",
      "Bash(gh release delete*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api *DELETE*)",
      "Bash(claude *--dangerously-skip-permissions*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.claude/channels/**/.env)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Bash(gh auth*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git status*",
      "git diff*",
      "git log*",
      "git show*",
      "git rev-parse*",
      "git switch *",
      "git fetch*",
      "git pull*",
      "git add *",
      "git commit *",
      "git push *",
      "gh issue *",
      "gh pr *",
      "gh run *",
      "gh *",
      "agent-review.py*",
      "autopilot-poll.py*",
      "autopilot-state.py*",
      "autopilot-task.py*",
      "autopilot-restart.sh*",
      "check-project.py*",
      ".claude/skills/pipeline/bin/check-project.py*",
      "cleanup-tree.py*",
      "default-branch.py*",
      "gate *",
      "issue-pr.py*",
      "issue-text.py*",
      "leave-branch.py*",
      "merge-default-branch.py*",
      "open-review-threads.py*",
      "pipeline-metrics.py*",
      "post-plan.py*",
      "release-changed.sh*",
      ".claude/skills/pipeline/host/update-pipeline.sh*",
      ".claude/skills/pipeline/host/use-release.sh*",
      "telegram-send.py*",
      "watch-ci.py*",
      "claude plugin validate*"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv"
      ],
      "denyRead": [
        "~/.config/gh",
        "~/.ssh",
        "~/.claude/.credentials.json",
        "~/.claude/channels"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && s=.claude/skills/pipeline/host/check-release.sh && if [ -x \"$s\" ]; then w=$(\"$s\"); else w=\"Warning: $s is missing, so Claude Code loads no pipeline rules, skills or hook. See INSTALL.md of the pipeline.\"; false; fi || python3 -c 'import json, sys; print(json.dumps({\"systemMessage\": sys.argv[1], \"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": sys.argv[1]}}))' \"$w\""
          }
        ]
      }
    ]
  }
}

[Unit]
Description=Claude Code autopilot in tmux session "autopilot"

[Service]
Type=forking
WorkingDirectory=%h/klarschiff.io
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/klarschiff.io/.github/scripts/autopilot-start.sh
ExecStop=%h/klarschiff.io/.github/scripts/autopilot-stop.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target

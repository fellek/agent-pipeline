[Unit]
Description=Claude Code autopilot in tmux session "@NAME@"

[Service]
Type=simple
WorkingDirectory=@PROJECT@
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@HOST@/autopilot-service.sh @LABEL@
ExecStop=@HOST@/autopilot-stop.sh
Restart=on-failure
RestartSec=30
RestartSteps=4
RestartMaxDelaySec=15min

[Install]
WantedBy=default.target
